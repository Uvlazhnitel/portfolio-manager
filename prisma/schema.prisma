generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AssetClass {
  ETF
  CRYPTO
  GOLD
  CASH
  OTHER
}

enum AssetType {
  CRYPTO
  ETF
  PHYSICAL_GOLD
  TOKENIZED_GOLD
  FIAT
  STABLECOIN
  OTHER
}

enum AccountType {
  EXCHANGE
  BROKER
  WALLET
  PHYSICAL
  BANK
  OTHER
}

enum CustodianCategory {
  EXCHANGE
  BROKER
  SELF_CUSTODY
  PHYSICAL
  BANK
  OTHER
}

enum TransactionType {
  INITIAL_BALANCE
  GIFT
  BUY
  SELL
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

enum BasisMethod {
  KNOWN_COST
  UNKNOWN
  ZERO_COST
  FAIR_VALUE
}

enum TransactionGroupKind {
  TRANSFER
  TRADE
}

enum PortfolioRuleType {
  PREFER_CONTRIBUTIONS_OVER_SELLING
  CHALLENGE_STRATEGY_VIOLATIONS
  PREFER_NO_ACTION_WHEN_EVIDENCE_WEAK
  CRYPTO_MAX_ALLOCATION
  MIN_REBALANCE_DRIFT
  SINGLE_ASSET_MAX_ALLOCATION
  CUSTODIAN_MAX_ALLOCATION
}

enum MarketPriceUnit {
  ASSET_UNIT
  GRAM
  TROY_OUNCE
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum IntegrationProvider {
  OPENAI
  COINGECKO
  ALPHA_VANTAGE
  TWELVE_DATA
}

enum AssetQuoteProvider {
  ALPHA_VANTAGE
  TWELVE_DATA
}

model Asset {
  id                       String                    @id @default(cuid())
  symbol                   String                    @unique
  name                     String
  assetClass               AssetClass
  assetType                AssetType
  currency                 String
  externalId               String?
  quoteProvider            AssetQuoteProvider?
  quoteSymbol              String?
  quoteMicCode             String?
  metadata                 Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  transactions             Transaction[]
  cachedPrices             CachedMarketPrice[]
  dailyPrices              DailyMarketPrice[]
  manualPrices             ManualMarketPrice[]
  strategyAssetAllocations StrategyAssetAllocation[]
  benchmarkStrategies      Strategy[]                  @relation("StrategyBenchmark")

  @@index([quoteProvider, quoteSymbol, quoteMicCode])
}

model DailyMarketPrice {
  id               String   @id @default(cuid())
  assetId          String
  currency         String
  date             DateTime @db.Date
  price            Decimal  @db.Decimal(28, 8)
  source           String
  quoteTimestamp   DateTime
  capturedAt       DateTime
  isStaleAtCapture Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, currency, date])
  @@index([currency, date])
  @@index([date])
}

model CachedMarketPrice {
  id        String   @id @default(cuid())
  assetId   String
  currency  String
  price     Decimal  @db.Decimal(28, 8)
  timestamp DateTime
  fetchedAt DateTime @default(now())
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, currency])
  @@index([currency])
  @@index([fetchedAt])
}

model ManualMarketPrice {
  id        String          @id @default(cuid())
  assetId   String
  currency  String
  price     Decimal         @db.Decimal(28, 8)
  unit      MarketPriceUnit
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, currency])
  @@index([currency])
}

model Custodian {
  id          String            @id @default(cuid())
  name        String            @unique
  category    CustodianCategory
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  accounts    Account[]
}

model Account {
  id           String        @id @default(cuid())
  name         String        @unique
  type         AccountType
  description  String?
  custodianId  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  custodian    Custodian?    @relation(fields: [custodianId], references: [id], onDelete: SetNull)

  @@index([custodianId])
}

model Transaction {
  id                 String          @id @default(cuid())
  assetId            String
  accountId          String
  type               TransactionType
  basisMethod        BasisMethod?
  quantity           Decimal         @db.Decimal(36, 18)
  pricePerUnit       Decimal?        @db.Decimal(28, 8)
  fee                Decimal?        @db.Decimal(28, 8)
  currency           String
  executedAt         DateTime
  note               String?
  transactionGroupId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactionGroup TransactionGroup? @relation(fields: [transactionGroupId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([accountId])
  @@index([executedAt])
  @@index([transactionGroupId])
}

model TransactionGroup {
  id           String               @id @default(cuid())
  kind         TransactionGroupKind
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions Transaction[]
}

model Strategy {
  id               String               @id @default(cuid())
  name             String
  objective        String
  baseCurrency     String
  benchmarkAssetId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  allocations      StrategyAllocation[]
  portfolioRules   PortfolioRule[]
  contributionPlan ContributionPlan?
  benchmarkAsset   Asset?               @relation("StrategyBenchmark", fields: [benchmarkAssetId], references: [id], onDelete: SetNull)

  @@index([benchmarkAssetId])
}

model ContributionPlan {
  id                 String   @id @default(cuid())
  strategyId         String   @unique
  contributionAmount Decimal  @db.Decimal(28, 2)
  currency           String
  allocations        Json
  isCustomized       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model StrategyAllocation {
  id            String     @id @default(cuid())
  strategyId    String
  assetClass    AssetClass
  targetPercent Decimal    @db.Decimal(5, 2)
  minPercent    Decimal    @db.Decimal(5, 2)
  maxPercent    Decimal    @db.Decimal(5, 2)

  strategy         Strategy                  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  assetAllocations StrategyAssetAllocation[]

  @@unique([strategyId, assetClass])
  @@index([strategyId])
}

model StrategyAssetAllocation {
  id                   String   @id @default(cuid())
  strategyAllocationId String
  assetId              String
  targetPercent        Decimal  @db.Decimal(5, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  strategyAllocation StrategyAllocation @relation(fields: [strategyAllocationId], references: [id], onDelete: Cascade)
  asset              Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([strategyAllocationId, assetId])
  @@index([strategyAllocationId])
  @@index([assetId])
}

model PortfolioRule {
  id         String            @id @default(cuid())
  strategyId String
  type       PortfolioRuleType
  enabled    Boolean           @default(true)
  config     Json
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, type])
  @@index([strategyId])
}

model AssistantConversation {
  id        String             @id @default(cuid())
  title     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  @@index([updatedAt])
}

model AssistantMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           AssistantMessageRole
  status         AssistantMessageStatus @default(COMPLETED)
  content        String               @db.Text
  createdAt      DateTime             @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, status, createdAt])
}

model IntegrationSetting {
  id              String              @id @default(cuid())
  provider        IntegrationProvider @unique
  encryptedApiKey String?             @db.Text
  apiKeySuffix    String?
  config          Json                @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}
